{
  "name": "quality-gate-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node ../../../scripts/run-vite-build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit --pretty false --incremental false",
    "test": "node ./scripts/test-quality-verifier.mjs && node ./scripts/agent-check.mjs",
    "quality:capture": "node ./scripts/capture-browser-evidence.mjs",
    "quality:verify": "node ./scripts/verify-quality-evidence.mjs",
    "test:submission": "npm run quality:verify && node ../../../scripts/verify-submission-contract.mjs ./submission-contract.json",
    "lint": "node ./scripts/lint-check.mjs",
    "format": "node ./scripts/format-check.mjs",
    "agent:check": "npm run test:integrity && npm run lint && npm run test && npm run format && npm run typecheck && npm run build",
    "test:integrity": "node ../../../scripts/verify-protected-inputs.mjs ./challenge-integrity.json",
    "verify:implementation": "npm run quality:verify",
    "verify:submission": "node ../../../scripts/comparable-evidence.mjs .. && npm run test:submission",
    "verify:exercise:core": "npm run agent:check && npm run verify:implementation && npm run verify:submission",
    "verify:exercise": "node ../../../scripts/run-clean-verification.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "lighthouse": "^13.4.1",
    "playwright": "^1.62.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  },
  "overrides": {
    "nanoid": "3.3.18"
  }
}
