{
  "name": "Minimal-Diff Scope Budget",
  "root": "..",
  "requiredFiles": [
    { "path": "evidence/before.md", "minCharacters": 250, "includeAll": ["Starting commit", "Implementation commit", "Agent and model", "Tools and permissions", "Time limit", "Human hints: 0", "Retries: 0", "Patch SHA-256"] },
    { "path": "evidence/before.patch", "minCharacters": 80, "includeAll": ["diff --git"] },
    { "path": "evidence/before-scope.json", "minCharacters": 120, "validJson": true, "includeAll": ["files", "additions", "deletions", "changedLines"] },
    { "path": "evidence/after.md", "minCharacters": 280, "includeAll": ["Starting commit", "Implementation commit", "Agent and model", "Tools and permissions", "Time limit", "Human hints: 0", "Retries: 0", "Patch SHA-256"] },
    { "path": "evidence/after.patch", "minCharacters": 80, "includeAll": ["diff --git"] },
    { "path": "evidence/comparison.md", "minCharacters": 500, "includeAll": ["Before", "After", "Same conditions", "Proof", "Conclusion"] },
    { "path": "evidence/scope-plan.json", "minCharacters": 500, "validJson": true, "includeAll": ["maximumFiles", "maximumChangedLines", "allowedSourceFiles", "excludedPaths"] },
    { "path": "evidence/scope-plan.md", "minCharacters": 600, "includeAll": ["before", "two", "30", "exportButton.mjs", "export-button.test.mjs", "excluded"] },
    { "path": "minimal-diff-app/tests/export-button.test.mjs", "minCharacters": 500, "includeAll": ["export", "checkout", "delete", "unknown", "legacy-primary", "legacy-danger", "ds-secondary"] },
    { "path": "evidence/scope-budget.json", "minCharacters": 650, "validJson": true, "includeAll": ["planSha", "sourceSha", "planned", "actual", "files", "additions", "deletions", "changedLines"] },
    { "path": "evidence/avoided-work.json", "minCharacters": 800, "validJson": true, "includeAll": ["actionButtons.mjs", "src/components", "src/styles.css", "package.json", "temptation", "reason", "unchanged"] },
    { "path": "evidence/avoided-work.md", "minCharacters": 600, "includeAll": ["checkout", "destructive", "shared", "styles", "cleanup", "reason"] },
    { "path": "evidence/verification.md", "minCharacters": 500, "includeAll": ["export", "checkout", "delete", "unknown", "pass", "exit code: 0"] },
    { "path": "evidence/commands/scope-verify.txt", "minCharacters": 250, "includeAll": ["Plan SHA", "Source SHA", "Actual scope", "evidence only"] }
  ]
}
