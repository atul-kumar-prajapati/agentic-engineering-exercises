{
  "name": "Risk-Based Model Routing Cost Gate",
  "root": "..",
  "requiredFiles": [
    { "path": "evidence/before.md", "minCharacters": 250, "includeAll": ["Starting commit", "Implementation commit", "Agent and model", "Tools and permissions", "Time limit", "Human hints: 0", "Retries: 0", "Patch SHA-256"] },
    { "path": "evidence/before.patch", "minCharacters": 80, "includeAll": ["diff --git"] },
    { "path": "evidence/after.md", "minCharacters": 280, "includeAll": ["Starting commit", "Implementation commit", "Agent and model", "Tools and permissions", "Time limit", "Human hints: 0", "Retries: 0", "Patch SHA-256"] },
    { "path": "evidence/after.patch", "minCharacters": 80, "includeAll": ["diff --git"] },
    { "path": "evidence/comparison.md", "minCharacters": 500, "includeAll": ["Before", "After", "Same conditions", "Proof", "Conclusion"] },
    { "path": "model-routing-app/tests/route-task.test.mjs", "minCharacters": 850, "includeAll": ["fast", "balanced", "reasoning", "clarify", "unknown", "cross-boundary", "case IDs"] },
    { "path": "evidence/routing-measurements.json", "minCharacters": 12000, "validJson": true, "includeAll": ["sampleKey", "responseSha256", "inputTokens", "outputTokens", "latencyMs", "qualityScore", "safetyPassed", "callCostUsd"] },
    { "path": "evidence/measurement-run.json", "minCharacters": 300, "validJson": true, "includeAll": ["schemaVersion", "routing-measurements-v1", "packSha256", "runsPerLane", "scorerVersion", "sourceSha"] },
    { "path": "evidence/cost-model.json", "minCharacters": 3500, "validJson": true, "includeAll": ["firstCallCost", "expectedAddedCost", "totalExpectedCost", "allReasoningExpectedCost", "savingsPercent", "adoption"] },
    { "path": "evidence/routing-policy.md", "minCharacters": 1000, "includeAll": ["precedence", "tie-break", "fast", "balanced", "reasoning", "clarify", "single retry", "field"] },
    { "path": "evidence/adoption.md", "minCharacters": 1200, "includeAll": ["quality", "safety", "cost", "latency", "variance", "benchmark", "held-out", "adopt"] },
    { "path": "evidence/commands/routing-verify.txt", "minCharacters": 300, "includeAll": ["36 protected offline", "single-retry escalation", "all-reasoning", "without an API key"] }
  ]
}
