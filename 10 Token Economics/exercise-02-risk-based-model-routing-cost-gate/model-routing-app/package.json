{
  "name": "model-routing-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node ../../../scripts/run-vite-build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit --pretty false --incremental false",
    "test": "node ./scripts/test-routing-verifier.mjs && node ./scripts/agent-check.mjs",
    "test:routing": "node ./scripts/run-routing-tests.mjs && node ./tests/route-task.test.mjs",
    "eval:fixtures": "node ./scripts/validate-routing-fixtures.mjs && node ./scripts/verify-benchmark-pack.mjs",
    "routing:score": "node ./scripts/score-routing-eval.mjs",
    "routing:verify": "node ./scripts/verify-routing-submission.mjs",
    "test:submission": "npm run test:routing && npm run routing:verify && node ../../../scripts/verify-submission-contract.mjs ./submission-contract.json",
    "lint": "node ./scripts/lint-check.mjs",
    "format": "node ./scripts/format-check.mjs",
    "agent:check": "npm run test:integrity && npm run lint && npm run test && npm run format && npm run typecheck && npm run build",
    "test:integrity": "node ../../../scripts/verify-protected-inputs.mjs ./challenge-integrity.json",
    "verify:implementation": "npm run test:routing",
    "verify:submission": "node ../../../scripts/comparable-evidence.mjs .. && npm run test:submission",
    "verify:exercise:core": "npm run agent:check && npm run verify:implementation && npm run verify:submission",
    "verify:exercise": "node ../../../scripts/run-clean-verification.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
