{
  "name": "Progressive Context Budget Refactor",
  "root": "..",
  "requiredFiles": [
    { "path": "evidence/before.md", "minCharacters": 250, "includeAll": ["Starting commit", "Implementation commit", "Agent and model", "Tools and permissions", "Time limit", "Human hints: 0", "Retries: 0", "Patch SHA-256", "Total UTF-8 bytes"] },
    { "path": "evidence/before.patch", "minCharacters": 80, "includeAll": ["diff --git", "adaptSession.mjs"] },
    { "path": "evidence/after.md", "minCharacters": 280, "includeAll": ["Starting commit", "Implementation commit", "Agent and model", "Tools and permissions", "Time limit", "Human hints: 0", "Retries: 0", "Patch SHA-256", "Total UTF-8 bytes"] },
    { "path": "evidence/after.patch", "minCharacters": 80, "includeAll": ["diff --git", "adaptSession.mjs"] },
    { "path": "evidence/comparison.md", "minCharacters": 500, "includeAll": ["Before", "After", "Same conditions", "Proof", "Conclusion"] },
    { "path": "evidence/context-plan.json", "minCharacters": 500, "validJson": true, "includeAll": ["schemaVersion", "tags", "questionTags", "openQuestions", "maximumBytes", "mandatoryIds", "expectedSelectedIds"] },
    { "path": "evidence/context-plan.md", "minCharacters": 700, "includeAll": ["before", "maximum", "mandatory", "authority", "open question"] },
    { "path": "token-budget-app/tests/context-selector.test.mjs", "minCharacters": 900, "includeAll": ["deterministic", "budget", "stale", "duplicate", "question"] },
    { "path": "token-budget-app/tests/session-adapter.test.mjs", "minCharacters": 700, "includeAll": ["adaptSession", "userId", "roles", "expiresAt", "duplicate", "synchronous"] },
    { "path": "evidence/context-ledger.json", "minCharacters": 1800, "validJson": true, "includeAll": ["planSha", "sourceSha", "selected", "skipped", "totalBytes", "remainingBytes", "reason"] },
    { "path": "evidence/decision.md", "minCharacters": 900, "includeAll": ["planned", "actual", "expanded", "stale", "verification", "correctness", "trade-off"] },
    { "path": "evidence/commands/context-tests.txt", "minCharacters": 250, "includeAll": ["real UTF-8", "mandatory", "deterministic", "exit code: 0"] },
    { "path": "evidence/commands/context-verify.txt", "minCharacters": 250, "includeAll": ["Plan SHA", "Source SHA", "Selected bytes", "evidence-only follow-up"] }
  ]
}
