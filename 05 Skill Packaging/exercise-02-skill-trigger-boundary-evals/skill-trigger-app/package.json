{
  "name": "skill-trigger-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "test": "node ./scripts/test-trigger-evaluation.mjs && node ./scripts/agent-check.mjs",
    "eval:fixtures": "node ./scripts/validate-trigger-fixtures.mjs",
    "eval:score": "node ./scripts/score-trigger-results.mjs",
    "skill:validate": "node ./scripts/validate-change-review-skill.mjs",
    "test:submission": "node ./scripts/verify-trigger-submission.mjs",
    "test:integrity": "node ../../../scripts/verify-protected-inputs.mjs ./challenge-integrity.json",
    "lint": "node ./scripts/lint-check.mjs",
    "format": "node ./scripts/format-check.mjs",
    "agent:check": "npm run test:integrity && npm run lint && npm run test && npm run format && npm run typecheck && npm run build",
    "verify:implementation": "npm run skill:validate",
    "verify:submission": "npm run test:submission",
    "verify:exercise": "npm run agent:check && npm run verify:implementation && npm run verify:submission"
  },
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
