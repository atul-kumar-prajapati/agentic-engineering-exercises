{
  "consumer": {
    "name": "workflow-gate-app"
  },
  "interactions": [
    {
      "description": "a valid workflow decision",
      "providerStates": [
        {
          "name": "workflow wf-101 exists"
        }
      ],
      "request": {
        "body": {
          "evidenceNote": "Contract evidence attached",
          "owner": "Asha",
          "status": "Ready"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/api/workflows/wf-101/decisions"
      },
      "response": {
        "body": {
          "customer": "Atlas Co",
          "decisionState": "accepted",
          "id": "wf-101",
          "note": "Contract evidence attached",
          "owner": "Asha",
          "score": 91,
          "status": "Ready"
        },
        "headers": {
          "Content-Type": "application/json",
          "content-type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.customer": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.score": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 202
      }
    },
    {
      "description": "a workflow list request",
      "providerStates": [
        {
          "name": "workflows exist"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/workflows"
      },
      "response": {
        "body": [
          {
            "customer": "Atlas Co",
            "decisionState": "needs-evidence",
            "id": "wf-101",
            "note": "Evidence missing",
            "owner": "Asha",
            "score": 91,
            "status": "Blocked"
          }
        ],
        "headers": {
          "Content-Type": "application/json",
          "content-type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$[*].customer": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].decisionState": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].note": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].owner": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].score": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].status": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "17.1.0"
    },
    "pactRust": {
      "ffi": "0.5.6",
      "models": "1.3.14"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "workflow-rules-api"
  }
}