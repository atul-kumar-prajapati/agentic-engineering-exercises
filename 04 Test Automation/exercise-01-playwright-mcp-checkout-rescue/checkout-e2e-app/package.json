{
  "name": "checkout-e2e-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "setup:browser": "playwright install chromium",
    "setup:check": "node ./scripts/check-playwright-setup.mjs && npm run test:smoke",
    "test:e2e": "playwright test",
    "test:e2e:reproduce": "playwright test tests/e2e/flaky-checkout.spec.ts --repeat-each=4 --workers=2",
    "test:smoke": "playwright test tests/e2e/starter-smoke.spec.ts --workers=1",
    "test:checkout": "node ./scripts/verify-checkout-submission.mjs",
    "test:submission": "npm run test:checkout",
    "test:integrity": "node ../../../scripts/verify-protected-inputs.mjs ./challenge-integrity.json",
    "test": "node ./scripts/agent-check.mjs",
    "lint": "node ./scripts/lint-check.mjs",
    "format": "node ./scripts/format-check.mjs",
    "agent:check": "npm run test:integrity && npm run lint && npm run test && npm run format && npm run typecheck && npm run build",
    "verify:implementation": "npm run test:e2e",
    "verify:submission": "npm run test:checkout",
    "verify:exercise": "npm run agent:check && npm run verify:implementation && npm run verify:submission"
  },
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
