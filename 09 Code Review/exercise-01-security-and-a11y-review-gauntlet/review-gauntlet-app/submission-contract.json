{
  "name": "Security and Accessibility Review Gauntlet",
  "root": "..",
  "requiredFiles": [
    { "path": "evidence/before.md", "minCharacters": 250, "includeAll": ["Starting commit", "Implementation commit", "Agent and model", "Tools and permissions", "Time limit", "Human hints: 0", "Retries: 0", "Patch SHA-256"] },
    { "path": "evidence/before.patch", "minCharacters": 80, "includeAll": ["diff --git"] },
    { "path": "evidence/after.md", "minCharacters": 280, "includeAll": ["Starting commit", "Implementation commit", "Agent and model", "Tools and permissions", "Time limit", "Human hints: 0", "Retries: 0", "Patch SHA-256"] },
    { "path": "evidence/after.patch", "minCharacters": 80, "includeAll": ["diff --git"] },
    { "path": "evidence/comparison.md", "minCharacters": 500, "includeAll": ["Before", "After", "Same conditions", "Proof", "Conclusion"] },
    { "path": "review-gauntlet-app/tests/review-regressions.test.ts", "minCharacters": 1000, "includeAll": ["describe", "it", "expect"] },
    { "path": "evidence/review.json", "validJson": true, "minCharacters": 2600, "includeAll": ["schemaVersion", "baseSha", "headSha", "sourceSha", "reviewerSession", "request-changes", "anchor", "scenario", "impact", "evidence", "testPath", "dismissalProof"] },
    { "path": "evidence/review.md", "minCharacters": 1800, "includeAll": ["Base SHA", "Head SHA", "Request changes", "Confirmed", "Dismissed", "Regression"] },
    { "path": "evidence/semgrep.json", "minCharacters": 250, "validJson": true, "includeAll": ["results", "react-dangerous-html-review", "ActionComposer.tsx", "SafeAnnouncement.tsx"] },
    { "path": "evidence/fixture-verification.txt", "minCharacters": 50, "includeAll": ["Review fixture verified: review-base..review-head"] },
    { "path": "evidence/commands/review-verify.txt", "minCharacters": 300, "includeAll": ["Source SHA", "PASS exact protected", "PASS every reported finding", "PASS every Semgrep", "PASS Git source binding"] },
    { "path": "evidence/commands/regression-replay.txt", "minCharacters": 160, "includeAll": ["confirmed findings each fail", "named regressions pass"] },
    { "path": "evidence/commands/semgrep-replay.txt", "minCharacters": 100, "includeAll": ["Semgrep", "protected head"] }
  ],
  "requiredDirectories": ["evidence", "evidence/commands"]
}
