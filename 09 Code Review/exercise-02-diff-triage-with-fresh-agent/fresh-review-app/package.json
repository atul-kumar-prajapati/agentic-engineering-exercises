{
  "name": "fresh-review-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "test": "node ./scripts/test-triage-verifier.mjs && node ./scripts/agent-check.mjs",
    "test:cache": "vitest run src/services/workflowApi.acceptance.test.ts tests/cache-regressions.test.ts && node ./scripts/run-app-cache-checks.mjs",
    "triage:verify": "node ./scripts/verify-triage-submission.mjs",
    "test:submission": "npm run test:cache && npm run triage:verify && node ../../../scripts/verify-submission-contract.mjs ./submission-contract.json",
    "lint": "node ./scripts/lint-check.mjs",
    "format": "node ./scripts/format-check.mjs",
    "agent:check": "npm run test:integrity && npm run lint && npm run test && npm run format && npm run typecheck && npm run build",
    "test:integrity": "node ../../../scripts/verify-protected-inputs.mjs ./challenge-integrity.json",
    "verify:implementation": "npm run test:cache",
    "verify:submission": "npm run test:submission",
    "verify:exercise": "npm run agent:check && npm run verify:implementation && npm run verify:submission"
  },
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
