{
  "name": "Code Review Skill Hardening",
  "root": "..",
  "requiredFiles": [
    { "path": "evidence/before.md", "minCharacters": 250, "includeAll": ["Starting commit", "Implementation commit", "Agent and model", "Tools and permissions", "Time limit", "Human hints: 0", "Retries: 0", "Patch SHA-256"] },
    { "path": "evidence/before.patch", "minCharacters": 80, "includeAll": ["diff --git"] },
    { "path": "evidence/after.md", "minCharacters": 280, "includeAll": ["Starting commit", "Implementation commit", "Agent and model", "Tools and permissions", "Time limit", "Human hints: 0", "Retries: 0", "Patch SHA-256"] },
    { "path": "evidence/after.patch", "minCharacters": 80, "includeAll": ["diff --git"] },
    { "path": "evidence/comparison.md", "minCharacters": 600, "includeAll": ["Before", "After", "Same conditions", "Proof", "Conclusion"] },
    { "path": "regression-review-app/skills/regression-review/SKILL.md", "minCharacters": 500, "includeAll": ["name:", "description:", "reproduce", "severity", "code anchor", "dismiss"] },
    { "path": "evidence/runs/before/historical-regression.json", "validJson": true, "minCharacters": 850, "includeAll": ["schemaVersion", "before", "sessionId", "runNonce", "runnerSha256", "adapterSha256", "promptSha256", "diffSha256", "transcriptSha256", "findings"] },
    { "path": "evidence/runs/before/security-regression.json", "validJson": true, "minCharacters": 850, "includeAll": ["schemaVersion", "before", "sessionId", "runNonce", "runnerSha256", "adapterSha256", "promptSha256", "diffSha256", "transcriptSha256", "findings"] },
    { "path": "evidence/runs/before/clean-control.json", "validJson": true, "minCharacters": 650, "includeAll": ["schemaVersion", "before", "sessionId", "runNonce", "runnerSha256", "adapterSha256", "promptSha256", "diffSha256", "transcriptSha256", "findings"] },
    { "path": "evidence/runs/after/historical-regression.json", "validJson": true, "minCharacters": 850, "includeAll": ["schemaVersion", "after", "sessionId", "runNonce", "runnerSha256", "adapterSha256", "promptSha256", "diffSha256", "transcriptSha256", "skillSha256", "findings"] },
    { "path": "evidence/runs/after/security-regression.json", "validJson": true, "minCharacters": 850, "includeAll": ["schemaVersion", "after", "sessionId", "runNonce", "runnerSha256", "adapterSha256", "promptSha256", "diffSha256", "transcriptSha256", "skillSha256", "findings"] },
    { "path": "evidence/runs/after/clean-control.json", "validJson": true, "minCharacters": 650, "includeAll": ["schemaVersion", "after", "sessionId", "runNonce", "runnerSha256", "adapterSha256", "promptSha256", "diffSha256", "transcriptSha256", "skillSha256", "findings"] },
    { "path": "evidence/scorecard.json", "validJson": true, "minCharacters": 1200, "includeAll": ["historicalCoverage", "securityCoverage", "precision", "cleanControl", "noRegression", "adopt"] },
    { "path": "evidence/review-eval.md", "minCharacters": 900, "includeAll": ["Baseline", "Skill-assisted", "Coverage", "Precision", "Clean control", "Decision"] },
    { "path": "evidence/commands/eval-verify.txt", "minCharacters": 250, "includeAll": ["six runner-captured review sessions", "prompt", "transcript", "skill contains no case answers", "Decision"] }
  ],
  "requiredDirectories": ["evidence", "evidence/prompts", "evidence/runs", "evidence/runs/before", "evidence/runs/after", "evidence/transcripts", "evidence/commands"]
}
